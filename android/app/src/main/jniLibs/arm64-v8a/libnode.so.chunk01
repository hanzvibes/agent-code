  setupTraceCategoryState();
  setupInspectorHooks();
  setupNetworkInspection();
  setupNavigator();
  setupWarningHandler();
  setupSQLite();
  setupStreamIter();
  setupQuic();
  setupWebStorage();
  setupWebsocket();
