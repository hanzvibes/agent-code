    return this.#handle[this.#offset + IDX_STATS_SESSION_PKT_RECV];
  }

  get bytesRecv() {
    assertIsQuicSessionStats(this);
    return this.#handle[this.#offset + IDX_STATS_SESSION_BYTES_RECV];
  }

  get pktLost() {
