      case kWebCryptoKeyFormatPKCS8: {
        const seed = handle.rawSeed();
        const buffer = new Uint8Array(54);
        const orc = {
          '__proto__': null,
          'ML-DSA-44': 0x11,
          'ML-DSA-65': 0x12,
          'ML-DSA-87': 0x13,
