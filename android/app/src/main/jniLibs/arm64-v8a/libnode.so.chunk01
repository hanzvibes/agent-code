    const stream = options?.stream;
    if (this[kUTF8FastPath]) {
      const chunk = this[kChunk];
      const ignoreBom = this[kIgnoreBOM] || this[kBOMSeen];
      if (!stream) {
        this[kBOMSeen] = false;
        if (!chunk) return decodeUTF8(input, ignoreBom, this[kFatal]);
      }

