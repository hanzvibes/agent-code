    } = this;

    return `QuicStreamState ${inspect({
      id,
      pending,
      finSent,
      finReceived,
      readEnded,
      writeEnded,
      reset,
      hasOutbound,
      hasReader,
      wantsBlock,
      wantsReset,
      wantsStopSending,
      wantsHeaders,
      wantsTrailers,
      early,
      resetCode,
      writeDesiredSize,
      budget,
    }, opts)}`;
  }

  [kFinishClose]() {
    // Cache the stream ID since the buffer will be zeroed out and the ID will be lost.
    this.#id = this.id;
    this.#handle = undefined;
  }
}

module.exports = {
  QuicEndpointState,
  QuicSessionState,
  QuicStreamState,
};

