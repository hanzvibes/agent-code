   * @param {string} specifier
   * @param {URL['href']} [parentURL] When `--experimental-import-meta-resolve` is specified, a
   *   second argument can be provided.
   * @returns {string}
   */
  return function resolve(specifier, parentURL = defaultParentURL) {
