/**
 * Redacts the userinfo (username/password) from a proxy URL so that credentials
 * never surface in error messages, which can end up in logs and crash reports.
 * This must not depend on parsing succeeding: it is used precisely when the URL
 * failed to parse.
 * @param {string} proxyUrl - The proxy URL to redact.
 * @returns {string} The proxy URL with any userinfo removed.
 */
function redactProxyUrl(proxyUrl) {
  const raw = `${proxyUrl}`;
  try {
    const parsedURL = new URL(raw);
    if (parsedURL.username || parsedURL.password) {
      parsedURL.username = '';
      parsedURL.password = '';
      return parsedURL.href;
    }
    return raw;
  } catch {
    // Unparseable: strip the userinfo textually. Greedy up to the last '@' in the
    // authority so a password containing '@' is redacted whole rather than
    // leaving a trailing fragment.
    return raw.replace(/\/\/[^/]*@/, '//[redacted]@');
