        .eddsaSignVerify(key, data, normalizedAlgorithm, signature);
    case 'HMAC':
      return require('internal/crypto/mac')
        .hmacSignVerify(key, data, normalizedAlgorithm, signature);
    case 'ML-DSA-44':
