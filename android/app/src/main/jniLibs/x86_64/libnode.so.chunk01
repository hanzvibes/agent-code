    try {
      const request = { specifier, __proto__: null };
      ({ url } = loader.resolveSync(parentURL, request));
      return url;
    } catch (error) {
      switch (error?.code) {
        case 'ERR_UNSUPPORTED_DIR_IMPORT':
        case 'ERR_MODULE_NOT_FOUND':
