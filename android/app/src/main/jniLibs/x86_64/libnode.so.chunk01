    if (normalizedAlgorithm.name === 'AES-KW' && json.length % 8 !== 0) {
      bytes = encodeUtf8String(
        json + StringPrototypeRepeat(' ', 8 - (json.length % 8)));
    } else {
      bytes = encodeUtf8String(json);
    }
  }

  return cipherOrWrap(
    kWebCryptoCipherEncrypt,
    normalizedAlgorithm,
    wrappingKey,
    bytes);
}

