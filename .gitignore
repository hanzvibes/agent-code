# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/local.properties
/android/.gradle/
/android/.kotlin/
/android/key.properties
*.jks
*.keystore
.env
.env.*
*.apk
*.aab

# Tier 2: libnode.so is reassembled at build time from committed
# libnode.so.chunk00..04 (GitHub Git Data API rejects the ~48 MB blob),
# so the reassembled file must never be committed. The chunks are NOT
# ignored and must be pushed.
android/app/src/main/jniLibs/*/libnode.so
